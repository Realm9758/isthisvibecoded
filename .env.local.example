# Copy this to .env.local and fill in your values

# App
# The canonical origin. Production is https://bhopstudio.com/ironclad
# This is not cosmetic: the scanner advertises <origin>/scanner in its
# user-agent string, and site owners follow that URL out of their logs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required; service role is server-only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth: generate with openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Recommended separate HMAC key for anonymous daily limits
RATE_LIMIT_SECRET=change-me-to-another-long-random-string
# Self-hosted only: enable after a trusted proxy is configured to overwrite
# X-Forwarded-For/X-Real-IP. Vercel is detected automatically.
TRUST_PROXY_HEADERS=false

# Leave false to use the bounded temporary Vercel executor. Set true only when
# the dedicated worker and its real fixed outbound addresses are live.
IRONCLAD_DURABLE_SCANNER_ENABLED=false
IRONCLAD_SCANNER_EGRESS_IPS=203.0.113.10,203.0.113.11
IRONCLAD_WORKER_ID=ironclad-worker-eu-1

# Hosting-provider domain verification. Create read-only OAuth applications.
# Generate the two local secrets with: openssl rand -hex 32
OAUTH_STATE_SECRET=change-me-to-a-random-state-signing-secret
OAUTH_TOKEN_ENCRYPTION_KEY=change-me-to-a-random-token-encryption-secret
VERCEL_INTEGRATION_SLUG=your-integration-slug
VERCEL_INTEGRATION_CLIENT_ID=your-vercel-client-id
VERCEL_INTEGRATION_CLIENT_SECRET=your-vercel-client-secret
NETLIFY_OAUTH_CLIENT_ID=your-netlify-client-id

# Stripe (optional unless billing is enabled)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRO_PRICE_ID=price_...
# Webhook secret from: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Email notifications (optional)
RESEND_API_KEY=re_...
EMAIL_FROM=VibeScan <notifications@example.com>
